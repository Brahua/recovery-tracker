# Environment variable names only. Never commit real values.

# Local development: run `npm run supabase:start` and `npm run supabase:env:local`
# to fill these with the local Supabase stack. Production values live only in Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Public origin of the app. Production: https://recovery-tracker.brahua.com · local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: only needed if you want Google OAuth to work against local Supabase CLI auth.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-google-client-id
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your-google-client-secret

# Push notifications (reminders). Generate once with `npx web-push generate-vapid-keys`.
# The public key is safe to expose; the private key is a secret (Vercel Production, Sensitive).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:you@example.com
VAPID_SUBJECT=

# Reminders dispatch (server only, Vercel Production, Sensitive). Never needed locally.
# service_role key: Supabase → Project Settings → API. Bypasses RLS; only the dispatch endpoint uses it.
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret that Supabase pg_cron sends as "Authorization: Bearer …": `openssl rand -base64 32`.
# The same value goes into Supabase Vault as reminders_dispatch_secret.
REMINDERS_DISPATCH_SECRET=

# Optional: Supabase CLI personal access token (`npm run supabase:login` stores one for you).
SUPABASE_ACCESS_TOKEN=
